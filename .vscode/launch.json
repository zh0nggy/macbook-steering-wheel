{
  // ===================================================================
  // RENAME + MOVE THIS FILE BEFORE IT WORKS:
  //   put it at  <your project folder>/.vscode/launch.json
  // Create the .vscode folder if it doesn't exist. The leading dot and the
  // exact filename both matter -- VS Code only looks in that one place.
  // Do this on BOTH machines.
  // ===================================================================
  //
  // EDIT THE IP ADDRESS in config 5 before first use. Get it by running
  // `ipconfig` on the Windows PC and reading the IPv4 Address line. Dorm WiFi
  // reassigns addresses periodically, so if it worked yesterday and not today,
  // check this first.
  //
  // "console": "integratedTerminal" appears on every config on purpose. It's
  // what lets Ctrl-C stop the program, and what lets mac_sender.py's
  // calibration prompt receive your Enter keypress. Without it the script
  // hangs at "Press Enter to calibrate" with no way to answer.
  "version": "0.2.0",
  "configurations": [
    {
      // WINDOWS, day 1 step A. No driver needed, no Mac needed.
      // Prints incoming values only. Start this first, leave it running.
      "name": "1. [WINDOWS] receiver -- dry run, no driver",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/pad_receiver.py",
      "console": "integratedTerminal",
      "args": ["--dry-run"]
    },
    {
      // WINDOWS, day 1 step B. Launch this WHILE config 1 is still running.
      // 127.0.0.1 means "this same machine" -- no network involved yet.
      "name": "2. [WINDOWS] mock sender -- fake steering sweep",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/mock_sender.py",
      "console": "integratedTerminal",
      "args": ["--host", "127.0.0.1", "--mode", "sweep"]
    },
    {
      // WINDOWS, day 1 step C. Needs ViGEmBus installed + `pip install vgamepad`.
      // Now the virtual controller actually moves. Verify in joy.cpl before
      // you go anywhere near the game.
      "name": "3. [WINDOWS] receiver -- real virtual pad",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/pad_receiver.py",
      "console": "integratedTerminal",
      "args": ["--deadzone", "0.05", "--gamma", "1.5"]
    },
    {
      // MAC, day 2 step A. Run once. Tilt the laptop while it runs, then read
      // the axis table it prints on exit (Ctrl-C to get there).
      "name": "4. [MAC] imu probe -- find the axes",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/imu_probe.py",
      "console": "integratedTerminal",
      "args": []
    },
    {
      // MAC, day 2 step B. The real thing.
      // REPLACE --lateral and --vertical with the axis numbers config 4 gave
      // you, and --host with your Windows PC's IP.
      "name": "5. [MAC] sender -- real steering",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/mac_sender.py",
      "console": "integratedTerminal",
      "args": [
        "--host", "192.168.1.42",
        "--lateral", "0",
        "--vertical", "2",
        "--range", "45"
      ]
    }
  ]

  // ---- if the probe can't open the sensor ----
  // launch.json can't help: VS Code won't prompt for a sudo password. Use the
  // integrated terminal directly:  sudo python3 imu_probe.py
  //
  // macOS may also ask for a permission (Input Monitoring / Accessibility) the
  // first time. That permission attaches to the app that spawned the process,
  // so granting it to VS Code doesn't always cover a debugger subprocess. If it
  // fails under VS Code but works in Terminal.app, that's the cause -- not a
  // bug in the code.
}
